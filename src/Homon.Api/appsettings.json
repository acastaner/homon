{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",

  "ConnectionStrings": {
    "Homon": ""
  },

  "FrontEnd": {
    "AllowedOrigins": [],
    "PublicBaseUrl": "http://localhost:5300"
  },

  "Auth": {
    "RequireSignInForReaders": false
  },

  "SignInThrottle": {
    "PermitLimit": 10,
    "WindowMinutes": 5
  },

  "Email": {
    "//": "Resend or Log. The Resend key, the sender and the recipients are not here: they are set on the Alerts admin page and stored in the database (plan 026). Production refuses Log.",
    "Transport": "Resend"
  },

  "Administrator": {
    "Email": null,
    "PasswordHash": null
  }
}
