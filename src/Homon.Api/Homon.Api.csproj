<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <!-- Exposed so Homon.Api.Tests can drive the host through WebApplicationFactory. -->
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <UserSecretsId>homon-api</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Homon.Infrastructure\Homon.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" />
    <PackageReference Include="Microsoft.Extensions.Diagnostics.HealthChecks.EntityFrameworkCore" />
    <!-- Startup project for `dotnet ef`; design-time only, never shipped. -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Homon.Api.Tests" />
  </ItemGroup>

</Project>
