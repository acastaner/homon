<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!--
      Deliberately the same id as Homon.Api. The design-time factory in this project is the
      only source of the connection string for `dotnet ef`, and it must read the very secret
      the API reads at run time — so both projects address one secret store.
    -->
    <UserSecretsId>homon-api</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Homon.Domain\Homon.Domain.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="HtmlSanitizer" />
    <PackageReference Include="Microsoft.AspNetCore.Identity.EntityFrameworkCore" />
    <!--
      IDataProtectionProvider (plan 003's ISecretProtector). See Directory.Packages.props for
      why this project needs it declared explicitly.
    -->
    <PackageReference Include="Microsoft.AspNetCore.DataProtection.Abstractions" />
    <!-- IDesignTimeDbContextFactory lives here; design-time only, never shipped. -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <!-- Read by the design-time factory so `dotnet ef` shares the API's connection string. -->
    <PackageReference Include="Microsoft.Extensions.Configuration.UserSecrets" />
    <!--
      AddHttpClient (plan 003's HttpProbeRunner named client). See Directory.Packages.props
      for why this project needs it declared explicitly.
    -->
    <PackageReference Include="Microsoft.Extensions.Http" />
    <!--
      This project uses plain Microsoft.NET.Sdk, not Microsoft.NET.Sdk.Web (that is
      Homon.Api.csproj only), so it gets no FrameworkReference to Microsoft.AspNetCore.App —
      BackgroundService, IHostedService and AddHostedService<T>() all live in this package and
      would not otherwise resolve. Needed for ProbeScheduler/ProbeObservationRetentionService.
    -->
    <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Options.ConfigurationExtensions" />
    <PackageReference Include="Microsoft.Extensions.Options.DataAnnotations" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" />
    <PackageReference Include="Resend" />
  </ItemGroup>

  <ItemGroup>
    <!--
      ProbeScheduler.TickAsync and ProbeObservationRetentionService.SweepAsync are internal —
      the tests that call them directly (ProbeSchedulerTests, ProbeObservationRetentionServiceTests)
      live in Homon.Api.Tests, a different assembly. Modelled on Homon.Api.csproj's own
      InternalsVisibleTo to the same test project.
    -->
    <InternalsVisibleTo Include="Homon.Api.Tests" />
  </ItemGroup>

</Project>
