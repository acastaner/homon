# Copy this file to .env and fill in real values.
# .env is .gitignored — never commit it.

# PostgreSQL password for the `homon` role.
#
# Development on a machine that uses docker-compose.yml: Compose reads this and creates the
# role with it. Development against a shared container (docs/postgres-setup-dev.md): the
# role is created by hand with this password, and the API's connection string — which
# carries it — lives in .NET user secrets, NOT in appsettings.Development.json, which is
# committed. Either way this file is the record of what the password is.
POSTGRES_PASSWORD=change_me_before_running

# Resend API key for alert email.
#
# Compose passes this to the API in production (compose.prod.yaml sets Email__ResendApiToken
# from it). .NET does NOT read this file, so for local development the same value must also
# be set in user secrets:
#
#   dotnet user-secrets --project src/Homon.Api set "Email:ResendApiToken" "<key>"
#
# Leave it unset locally to keep LoggingEmailSender, which logs alerts instead of sending.
RESEND_API_TOKEN=

# ---------------------------------------------------------------------------------------
# Production only (compose.prod.yaml). Nothing below this line is read locally.
# ---------------------------------------------------------------------------------------

# The bare release version — no leading `v` — matching the GHCR image tag, e.g. `0.1.0`.
# Left as `latest` here by hand; `deploy.sh` overwrites this line in the real `.env` on
# every deploy, pinning the exact version it just pulled.
HOMON_VERSION=latest

# The application's single public origin, as the family reaches it. The SPA and the API are
# both served from it, and the API reads it as FrontEnd__PublicBaseUrl to build the links
# it emails.
HOMON_PUBLIC_ORIGIN=http://homon.lan.example

# The administrator's credentials. Mint the hash with:
#   dotnet run --project src/Homon.Api -- hash-password
# which reads the password from stdin. Only the hash goes in a file, never the password —
# a database compromise then yields nothing that can sign in as this account.
HOMON_ADMIN_EMAIL=<admin@example.com>
HOMON_ADMIN_PASSWORD_HASH=<paste the hash here, never the password>

# Whether readers must sign in. `false` — the intended deployment — leaves the dashboard
# open to anyone who can reach the port, which is what the reverse proxy's trusted-network
# rules are for. `true` closes every read endpoint to anonymous callers.
HOMON_REQUIRE_SIGN_IN_FOR_READERS=false

# Alert email. The sender must be on a domain verified in Resend, or outbound mail is
# rejected. At least one recipient; a second is optional.
HOMON_FROM_ADDRESS=homon@mail.example.com
HOMON_ALERT_RECIPIENT_1=<you@example.com>
HOMON_ALERT_RECIPIENT_2=

# The one published port, and the interface it binds. 0.0.0.0 is the intended host's
# convention (every container there binds all interfaces and the network in front is the
# access control); set 127.0.0.1 on a host whose reverse proxy runs locally.
HOMON_HOST_PORT=8102
HOMON_BIND_ADDRESS=0.0.0.0

# Optional — the Compose network the web container proxies from, as seen from inside the
# api container. With this set (compose.prod.yaml reads it as ReverseProxy__KnownNetwork),
# the API trusts X-Forwarded-For from that one hop and the sign-in rate limiter partitions
# on the real client instead of on nginx's address. Leave unset to accept the
# 172.16.0.0/12 default, which covers Docker's default bridge pools.
HOMON_PROXY_NETWORK=
